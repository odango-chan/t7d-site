---
import type { PublicCharacter } from "../../data/characters/characters";

interface Props {
  character: PublicCharacter;
}

const { character } = Astro.props;
const no = String(character.order).padStart(2, "0");
const base = import.meta.env.BASE_URL;
const artSrc = character.art ? `${base}${character.art.src}` : null;
---

<article class="character-folio" id={character.id}>
  <header class="character-index">
    <span class="character-no">{no}</span>
    <div>
      <h2>{character.name}</h2>
      <p>{character.romanized}</p>

      <dl class="character-quick">
        <div>
          <dt>种族</dt>
          <dd>{character.species}</dd>
        </div>
        <div>
          <dt>身份</dt>
          <dd>{character.identity}</dd>
        </div>
        <div>
          <dt>性格</dt>
          <dd>{character.traits}</dd>
        </div>
      </dl>

      <a class="character-detail-link" href={`${base}characters/${character.id}/`}>
        查看设定资料
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  {
    character.art && artSrc ? (
      <figure class="character-portrait character-portrait-published">
        <img src={artSrc} alt={character.art.alt} loading="lazy" />
        {character.art.caption && <figcaption>{character.art.caption}</figcaption>}
      </figure>
    ) : (
      <figure class="character-portrait" aria-label={`${character.name} 人物肖像预留`}>
        <span class="portrait-code">PORTRAIT / {no}</span>
        <span class="portrait-name">{character.name}</span>
        <figcaption>人物图待公开</figcaption>
      </figure>
    )
  }

  <div class="character-voice">
    <span class="voice-label">VOICE</span>
    <blockquote>“{character.quote}”</blockquote>
  </div>
</article>
