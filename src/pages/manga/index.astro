---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { mangaChapters } from "../../data/manga/chapters";
import "../../styles/manga.css";

const base = import.meta.env.BASE_URL;
---

<SiteLayout title="漫画">
  <div class="site-shell">
    <header class="page-head manga-head">
      <p class="section-kicker">Manga · Public Edition</p>
      <h1>漫画</h1>
      <p>
        同一段七日故事的画面版本。正文阅读方向固定为左 → 右，
        标准版正文以黑白 / 灰阶为基线。
      </p>
    </header>

    <section class="manga-system" aria-label="漫画阅读规则">
      <div>
        <span>READING</span>
        <strong>左 → 右</strong>
      </div>
      <div>
        <span>BODY</span>
        <strong>B&amp;W / GRAYSCALE</strong>
      </div>
      <p>
        这里只发布完成制作与审查的漫画页。分镜、Rough、制作清单和内部 review 不作为公开漫画内容。
      </p>
    </section>

    <section class="section">
      <div class="manga-chapter-list">
        {mangaChapters.map((chapter) => (
          <a class="manga-chapter-entry" href={`${base}manga/${chapter.id}/`}>
            <span class="manga-chapter-no">{String(chapter.order).padStart(2, "0")}</span>
            <div class="manga-chapter-name">
              <small>{chapter.dayLabel}</small>
              <h2>{chapter.title}</h2>
              <p>{chapter.subtitle}</p>
            </div>
            <span class="manga-chapter-state">{chapter.publicationStatus}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
