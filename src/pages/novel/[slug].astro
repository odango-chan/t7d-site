---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/reader.css";

export async function getStaticPaths() {
  const chapters = (await getCollection("novel"))
    .filter((entry) => entry.data.section === "novel")
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

  return chapters.map((chapter, index) => ({
    params: { slug: chapter.data.slug },
    props: {
      chapter,
      previous: index > 0 ? chapters[index - 1] : null,
      next: index < chapters.length - 1 ? chapters[index + 1] : null,
    },
  }));
}

const { chapter, previous, next } = Astro.props;
const { Content } = await render(chapter);
const base = import.meta.env.BASE_URL;
const illustrationSlots = chapter.data.illustrationSlots ?? [];
---

<SiteLayout title={chapter.data.title}>
  <div class="reader-toolbar" aria-label="阅读设置">
    <a href={`${base}novel/`}>← 目录</a>
    <span class="spacer"></span>
    <button type="button" data-reader-font-down aria-label="减小字号">A−</button>
    <button type="button" data-reader-font-up aria-label="增大字号">A+</button>
    <button type="button" data-reader-width aria-label="切换版心">宽</button>
    <button type="button" data-reader-theme aria-label="切换明暗">明暗</button>
  </div>

  <article class="reader">
    <header class="reader-head">
      <p class="reader-kicker">Novel · Release Candidate</p>
      <h1 class="reader-title">{chapter.data.title}</h1>
      <div class="reader-daymark" aria-hidden="true">
        <span>Seven-Day Notes</span>
        <strong>{String(chapter.data.order ?? 0).padStart(2, "0")}</strong>
      </div>
    </header>

    <div class="reader-ornament" aria-hidden="true">T7D · TEXT EDITION</div>

    {chapter.data.openerSlot && (
      <figure class="illustration-slot" data-slot={chapter.data.openerSlot}>
        {chapter.data.openerSlot} · CHAPTER FRONTISPIECE
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    {illustrationSlots.length > 0 && (
      <template id="inline-illustration-slots">
        {illustrationSlots.map((slot) => (
          <figure class="illustration-slot full" data-slot={slot}>
            {slot} · ILLUSTRATION RESERVED
          </figure>
        ))}
      </template>
    )}

    <nav class="chapter-nav" aria-label="章节导航">
      {previous
        ? <a href={`${base}novel/${previous.data.slug}/`}>← {previous.data.title}</a>
        : <span>← 上一章</span>}
      <a href={`${base}novel/`}>目录</a>
      {next
        ? <a href={`${base}novel/${next.data.slug}/`}>{next.data.title} →</a>
        : <span>下一章 →</span>}
    </nav>
  </article>

  <script>
    import "../../scripts/reader";
  </script>
</SiteLayout>
