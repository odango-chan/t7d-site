---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
const chapters = (await getCollection("novel")).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<SiteLayout title="小说">
  <div class="site-shell">
    <header class="page-head">
      <p class="section-kicker">Novel · Release Edition</p>
      <h1>小说</h1>
      <p>
        《東方七日祭》的连续阅读版。正文以主仓的 Release Draft 为生产真源，
        这里只保留已经批准公开的发布副本。
      </p>
    </header>

    <section class="section">
      <div class="chapter-list">
        {chapters.map((chapter) => (
          <a class="chapter-entry" href={`${base}novel/${chapter.data.slug}/`}>
            <span class="chapter-order">{String(chapter.data.order ?? 0).padStart(2, "0")}</span>
            <h2 class="chapter-title">{chapter.data.title}</h2>
            <span class="chapter-meta">Read</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
