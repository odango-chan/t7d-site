
---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
const chapters = (await getCollection("novel")).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<SiteLayout title="小说">
  <div class="site-shell">
    <header class="page-head">
      <p class="eyebrow">Novel</p>
      <h1>小说</h1>
      <p>《東方七日祭》小说公开阅读版。当前先迁移第一日验证正式站点结构。</p>
    </header>

    <section class="section">
      <div class="card-grid">
        {chapters.map((chapter) => (
          <a class="card" href={`${base}novel/${chapter.data.slug}/`}>
            <small>{chapter.data.releaseStatus}</small>
            <h3>{chapter.data.title}</h3>
            <p>阅读章节 →</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
