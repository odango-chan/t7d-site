---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { characters, type PublicCharacter } from "../../data/characters/characters";
import "../../styles/characters.css";

export function getStaticPaths() {
  return characters.map((character) => ({
    params: { id: character.id },
    props: { character },
  }));
}

interface Props {
  character: PublicCharacter;
}

const { character } = Astro.props;
const base = import.meta.env.BASE_URL;
const no = String(character.order).padStart(2, "0");
const total = String(characters.length).padStart(2, "0");
const resolveMediaSrc = (src: string) => /^https?:\/\//.test(src) ? src : `${base}${src}`;
const artSrc = character.art ? resolveMediaSrc(character.art.src) : null;
const expressionsArtSrc = character.expressionsArt ? resolveMediaSrc(character.expressionsArt.src) : null;
const posesArtSrc = character.posesArt ? resolveMediaSrc(character.posesArt.src) : null;
---

<SiteLayout
  title={`${character.name} · 人物设定`}
  description={`${character.name}（${character.romanized}）的《東方七日祭》公开人物设定资料。`}
>
  <div class="site-shell character-detail-shell">
    <nav class="character-detail-nav" aria-label="人物设定导航">
      <a href={`${base}characters/`}>← 返回人物目录</a>
      <span>{no} / {total}</span>
    </nav>

    <section class:list={["character-detail-hero", character.art && "character-detail-hero--with-art"]}>
      <div class="character-detail-hero-copy">
        <p class="section-kicker">Character Notes</p>
        <h1>{character.name}</h1>
        <p class="character-detail-romanized">{character.romanized}</p>

        <blockquote>“{character.quote}”</blockquote>

        <div class="character-detail-summary">
          <p class="character-detail-eyebrow">人物小记</p>
          <p>{character.summary}</p>
        </div>

        <div class="character-detail-scope">
          <span>{character.origin}</span>
        </div>
      </div>

      {
        character.art && artSrc && (
          <figure class="character-detail-art">
            <img src={artSrc} alt={character.art.alt} />
            {character.art.caption && <figcaption>{character.art.caption}</figcaption>}
          </figure>
        )
      }
    </section>

    <section class="character-detail-grid" aria-label="基本资料">
      <h2>人物资料</h2>
      <dl class="character-profile-grid">
        <div><dt>种族</dt><dd>{character.species}</dd></div>
        <div><dt>身高</dt><dd>{character.height}</dd></div>
        <div><dt>年龄</dt><dd>{character.age}</dd></div>
        <div><dt>身份</dt><dd>{character.identity}</dd></div>
        <div><dt>能力</dt><dd>{character.ability}</dd></div>
        <div><dt>性格</dt><dd>{character.traits}</dd></div>
      </dl>
    </section>

    <section class="character-detail-grid">
      <h2>说话的感觉</h2>
      <div class="character-detail-copy">
        <p>{character.speakingStyle}</p>
      </div>
    </section>

    <section class="character-detail-grid">
      <h2>外观</h2>
      <dl class="character-visual-list">
        <div><dt>体态</dt><dd>{character.visual.body}</dd></div>
        <div><dt>脸 / 发型</dt><dd>{character.visual.faceHair}</dd></div>
        <div><dt>服装</dt><dd>{character.visual.outfit}</dd></div>
        <div><dt>鞋袜</dt><dd>{character.visual.footwear}</dd></div>
        {character.visual.palette && <div><dt>配色</dt><dd>{character.visual.palette}</dd></div>}
      </dl>
    </section>

    <section class="character-detail-grid">
      <h2>随身物件</h2>
      <div>
        {
          character.props.length > 0 ? (
            <ul class="character-tag-list">
              {character.props.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p class="character-empty-note">没有特别固定的手持物件。</p>
          )
        }
      </div>
    </section>

    <section class="character-detail-pair character-detail-gallery-pair">
      <div>
        <h2>常见神情</h2>
        <ul class="character-tag-list">
          {character.expressions.map((item) => <li>{item}</li>)}
        </ul>
        {
          character.expressionsArt && expressionsArtSrc && (
            <figure class="character-reference-art">
              <img
                src={expressionsArtSrc}
                alt={character.expressionsArt.alt}
                loading="lazy"
                decoding="async"
              />
              {character.expressionsArt.caption && <figcaption>{character.expressionsArt.caption}</figcaption>}
            </figure>
          )
        }
      </div>

      <div>
        <h2>常见动作</h2>
        <ul class="character-tag-list">
          {character.poses.map((item) => <li>{item}</li>)}
        </ul>
        {
          character.posesArt && posesArtSrc && (
            <figure class="character-reference-art">
              <img
                src={posesArtSrc}
                alt={character.posesArt.alt}
                loading="lazy"
                decoding="async"
              />
              {character.posesArt.caption && <figcaption>{character.posesArt.caption}</figcaption>}
            </figure>
          )
        }
      </div>
    </section>

    <p class="character-detail-footnote">人物资料会随正式公开内容逐步补充。</p>
  </div>
</SiteLayout>
